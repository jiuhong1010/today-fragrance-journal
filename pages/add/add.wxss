.add-page { padding-bottom: 100rpx; animation: page-enter 360ms cubic-bezier(.16, 1, .3, 1) both; }
.mode-tabs { display: flex; border-bottom: 1rpx solid #303035; margin-top: 22rpx; }.mode-tab { flex: 1; text-align: center; color: #89858d; padding: 20rpx 0; font-size: 27rpx; position: relative; }.mode-tab.active { color: #f0edf1; }.mode-tab.active:after { content: ""; position: absolute; bottom: -1rpx; left: 34%; right: 34%; height: 4rpx; background: #d65c84; border-radius: 4rpx; }
.search-box { height: 84rpx; border: 1rpx solid #36353a; border-radius: 44rpx; display: flex; align-items: center; padding: 0 24rpx; background: #171719; margin-top: 28rpx; }.search-icon { width: 38rpx; height: 38rpx; margin-right: 14rpx; }.search-box input { flex: 1; color: #e7e2e8; font-size: 25rpx; }.search-placeholder { color: #79757d; }
.filter-scroll { width: 100%; white-space: nowrap; margin-top: 20rpx; }.filters { display: flex; gap: 14rpx; padding-bottom: 22rpx; }.filter { flex: 0 0 auto; padding: 13rpx 25rpx; background: #1c1c1f; color: #aaa5ae; border-radius: 32rpx; font-size: 24rpx; }.filter.active { border: 1rpx solid #d65c84; color: #f0edf1; background: #251a21; }
.catalog-list { display: flex; flex-direction: column; gap: 12rpx; }.catalog-row { min-height: 126rpx; display: flex; align-items: center; padding: 13rpx 18rpx; }.catalog-image-wrap { width: 76rpx; height: 100rpx; margin-right: 20rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,.09); border-radius: 14rpx; background: #f5f3ef; box-shadow: 0 7rpx 14rpx rgba(0,0,0,.2); flex: 0 0 auto; }.catalog-image { display: block; width: 100%; height: 100%; }.catalog-copy { flex: 1; min-width: 0; }.catalog-copy text:first-child { display: block; color: #f0edf1; font-size: 27rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.catalog-copy text:last-child { display: block; color: #85818a; font-size: 21rpx; margin-top: 7rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.add-mini { height: 52rpx; line-height: 50rpx; padding: 0 20rpx; margin-left: 14rpx; color: #d65c84; border: 1rpx solid #d65c84; background: transparent; border-radius: 28rpx; font-size: 22rpx; }.added-label { margin-left: 14rpx; color: #77737b; font-size: 21rpx; }
.manual-intro { padding: 42rpx 2rpx 28rpx; }.manual-intro text:first-child { display: block; color: #eeeaef; font-size: 34rpx; line-height: 1.45; }.manual-intro text:last-child { display: block; color: #8f8a93; font-size: 23rpx; margin-top: 12rpx; }
.form-block { padding: 0 24rpx; }.form-row { min-height: 94rpx; display: flex; align-items: center; border-bottom: 1rpx solid #303035; color: #e7e2e8; font-size: 25rpx; }.form-row:last-child { border-bottom: 0; }.form-row > text:first-child { width: 172rpx; }.form-row input { flex: 1; color: #f0edf1; font-size: 25rpx; text-align: right; }.form-value { margin-left: auto; color: #b3aeb6; padding-right: 28rpx; position: relative; }.form-value:after { content: ""; position: absolute; right: 3rpx; top: 50%; width: 11rpx; height: 11rpx; border-right: 2rpx solid #8f8992; border-bottom: 2rpx solid #8f8992; transform: translateY(-50%) rotate(-45deg); }.picker-grid { display: flex; gap: 20rpx; border-bottom: 1rpx solid #303035; }.picker-grid > picker { flex: 1; }.picker-grid .form-row { border-bottom: 0; }.compact { display: block; padding: 20rpx 0; min-height: 110rpx; }.compact .form-value { display: block; margin-top: 12rpx; font-size: 23rpx; }.textarea-row { align-items: flex-start; padding-top: 24rpx; min-height: 150rpx; }.textarea-row textarea { flex: 1; height: 100rpx; color: #eeeaf0; font-size: 24rpx; }.form-note { display: block; color: #77737b; font-size: 22rpx; line-height: 1.5; margin-top: 20rpx; }.save-manual { width: 100%; margin-top: 34rpx; }
