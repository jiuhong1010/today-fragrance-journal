.wardrobe-page { padding-bottom: 228rpx; animation: page-enter 360ms cubic-bezier(.16, 1, .3, 1) both; }
.wardrobe-heading { height: 124rpx; display: flex; align-items: center; }
.count-number { font-size: 64rpx; color: #f0edf1; font-variant-numeric: tabular-nums; }
.count-label { color: #beb9c1; font-size: 26rpx; margin: 20rpx 0 0 8rpx; }
.record-link { margin-left: auto; color: #a39da6; font-size: 24rpx; padding: 20rpx 0 20rpx 24rpx; display: flex; align-items: center; }
.record-link image { width: 30rpx; height: 30rpx; margin-left: 7rpx; }
.filter-scroll { width: 100%; white-space: nowrap; }
.filters { display: flex; gap: 14rpx; padding-bottom: 28rpx; }
.filter { flex: 0 0 auto; padding: 14rpx 25rpx; border-radius: 34rpx; background: #1a1a1d; color: #aaa4ad; font-size: 25rpx; border: 1rpx solid #242327; }
.filter.active { color: #f3ecf1; border-color: #d65c84; background: #251a21; }
.filter-check { display: inline-block; width: 13rpx; height: 7rpx; margin: -3rpx 0 0 12rpx; border-left: 2rpx solid #d65c84; border-bottom: 2rpx solid #d65c84; transform: rotate(-45deg); }
.wardrobe-list { display: flex; flex-direction: column; gap: 14rpx; }
.wardrobe-item { min-height: 148rpx; display: flex; align-items: center; padding: 17rpx 20rpx; transition: transform 160ms ease-out; }
.wardrobe-item:active { transform: scale(.99); background: #1d1d20; }
.mini-bottle { width: 92rpx; height: 112rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,.09); border-radius: 17rpx; background: #f5f3ef; box-shadow: 0 9rpx 18rpx rgba(0,0,0,.24); flex: 0 0 auto; }
.mini-bottle image { display: block; width: 100%; height: 100%; }
.wardrobe-copy { flex: 1; min-width: 0; padding-left: 24rpx; }
.wardrobe-name { display: block; color: #f0edf1; font-size: 29rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.wardrobe-family { display: block; color: #8f8992; font-size: 22rpx; margin-top: 9rpx; }
.wardrobe-time { display: flex; align-items: center; gap: 9rpx; color: #d36a8c; font-size: 22rpx; white-space: nowrap; }
.wardrobe-time .chevron-icon { width: 30rpx; height: 30rpx; }
.wardrobe-empty { text-align: center; padding: 86rpx 20rpx 0; }
.empty-bottle { width: 180rpx; height: 180rpx; margin: 0 auto 30rpx; opacity: .6; filter: grayscale(1) drop-shadow(0 14rpx 18rpx rgba(0,0,0,.28)); }
.wardrobe-empty .empty-copy { display: block; max-width: 540rpx; margin: 16rpx auto 0; }
.empty-action { display: flex; width: 100%; margin-top: 30rpx; }
.empty-action + .empty-action { margin-top: 16rpx; }
.wardrobe-actions { margin-top: 28rpx; }
.education-entry { margin-top: 28rpx; min-height: 100rpx; display: flex; align-items: center; padding: 0 24rpx; color: #c8c2ca; }
.education-entry > text { flex: 1; margin-left: 18rpx; }
.book-icon { width: 40rpx; height: 40rpx; }
.settings-link { margin: 20rpx auto 0; padding: 16rpx 24rpx; color: #827c85; font-size: 22rpx; text-align: center; }
