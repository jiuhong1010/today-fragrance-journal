.detail-page { padding-bottom: 90rpx; animation: page-enter 360ms cubic-bezier(.16, 1, .3, 1) both; }
.detail-hero { text-align: center; padding: 42rpx 0 36rpx; border-bottom: 1rpx solid #2f2f33; }
.detail-bottle { width: 224rpx; height: 276rpx; margin: 0 auto 26rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,.1); border-radius: 30rpx; background: #f5f3ef; box-shadow: 0 20rpx 42rpx rgba(0,0,0,.32); }
.detail-bottle image { display: block; width: 100%; height: 100%; animation: bottle-settle 650ms cubic-bezier(.16, 1, .3, 1) both; }
@keyframes bottle-settle { from { opacity: .45; transform: translateY(16rpx) scale(.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
.detail-name { display: block; font-size: 47rpx; line-height: 1.3; color: #f2eef1; }
.detail-en { display: block; color: #8e8891; margin: 10rpx 0 18rpx; letter-spacing: 1.8rpx; font-size: 21rpx; }
.family-pill { display: inline-block; color: #b9a0d2; border: 1rpx solid #a78bc3; border-radius: 24rpx; padding: 8rpx 18rpx; font-size: 22rpx; }
.detail-copy { padding: 30rpx 0 28rpx; }
.detail-brand { color: #aaa4ad; font-size: 23rpx; }
.material-row { display: flex; gap: 12rpx; margin-top: 20rpx; }
.material-card { flex: 1; min-width: 0; background: #19191b; border: 1rpx solid #28272b; border-radius: 14rpx; padding: 19rpx 13rpx; }
.material-card text:first-child { display: block; color: #eeeaf0; font-size: 24rpx; }
.material-card text:last-child { display: block; color: #8e8991; font-size: 20rpx; margin-top: 8rpx; line-height: 1.45; }
.detail-meta { padding: 8rpx 24rpx; }
.detail-meta view { min-height: 80rpx; display: flex; align-items: center; border-bottom: 1rpx solid #303035; font-size: 24rpx; }
.detail-meta view:last-child { border-bottom: 0; }
.detail-meta view text:first-child { color: #8f8992; width: 180rpx; }
.detail-meta view text:last-child { color: #ded9df; flex: 1; }
.detail-action { margin-top: 36rpx; }
