.settings-page { padding-bottom: 80rpx; }.privacy-note { margin-top: 38rpx; padding: 28rpx; }.privacy-note text:first-child { display: block; color: #f0edf1; font-size: 30rpx; line-height: 1.4; }.privacy-note text:last-child { display: block; color: #97929a; font-size: 23rpx; line-height: 1.65; margin-top: 16rpx; }.settings-group { margin-top: 18rpx; padding: 0 24rpx; }.setting-row { min-height: 94rpx; border-bottom: 1rpx solid #303035; display: flex; align-items: center; color: #e7e2e8; font-size: 25rpx; }.setting-row:last-child { border-bottom: 0; }.setting-row switch { margin-left: auto; transform: scale(.8); }.setting-value { margin-left: auto; color: #8c8790; }.danger-zone { margin-top: 42rpx; text-align: center; }.danger-button { width: 100%; height: 86rpx; line-height: 84rpx; color: #d65c84; background: transparent; border: 1rpx solid #7d3c56; border-radius: 14rpx; font-size: 26rpx; }.danger-zone text { display: block; color: #716d75; font-size: 21rpx; margin-top: 14rpx; }.settings-foot { color: #656169; font-size: 21rpx; line-height: 1.7; text-align: center; margin-top: 100rpx; }
