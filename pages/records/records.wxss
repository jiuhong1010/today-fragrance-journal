.records-page { padding-bottom: 80rpx; }.records-empty { text-align: center; padding-top: 220rpx; }.records-empty .empty-copy { display: block; max-width: 520rpx; margin: 18rpx auto; }.timeline { padding: 30rpx 0; position: relative; }.timeline:before { content: ""; position: absolute; left: 15rpx; top: 40rpx; bottom: 30rpx; width: 1rpx; background: #37343b; }.record-item { position: relative; padding: 0 0 28rpx 48rpx; }.timeline-dot { position: absolute; left: 7rpx; top: 9rpx; width: 17rpx; height: 17rpx; border-radius: 50%; background: #d65c84; box-shadow: 0 0 0 5rpx #261a21; }.record-date { color: #87828b; font-size: 22rpx; margin-bottom: 10rpx; }.record-body { min-height: 100rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; }.record-name { display: block; color: #eeeaf0; font-size: 28rpx; }.record-meta { display: block; color: #85818a; font-size: 22rpx; margin-top: 9rpx; }.rating { font-size: 23rpx; }.rating-good { color: #d65c84; }.rating-bad { color: #a987a5; }.rating-normal { color: #9d98a1; }
